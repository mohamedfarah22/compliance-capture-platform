                     type="PhoneNum"
                     minOccurs="0"
                     maxOccurs="unbounded"/>
         <xs:element name="email" type="Email" minOccurs="0" maxOccurs="unbounded"/>
         <xs:element name="occupationBusinessActivity" type="Description" minOccurs="0"/>
         <xs:choice minOccurs="0">
            <xs:element name="businessStructure" type="BusinessStructure"/>
            <xs:element name="businessStructureOther" type="Description"/>
         </xs:choice>
      </xs:sequence>
      <xs:assert test="if (isIncorporatedOverseas = 'Y') then exists(businessLicence) else true()"
                 xrcs:message="Provide details of the foreign business registration/licence number and the country of issue if the organisation is incorporated outside of Australia"/>
      <xs:assert test="if (isIncorporatedOverseas = 'N') then empty(businessLicence) else true()"
                 xrcs:message="Do not provide details of the foreign registration/licence number and the country of issue if the organisation is not incorporated outside of Australia"/>
      <xs:assert test="fn:upper-case(substring(businessAddress/addr,1,6)) != 'PO BOX'"
                 xrcs:message="This address cannot be a post office box or similar address"/>
      <xs:assert test="fn:upper-case(substring(registeredAddress/addr,1,6)) != 'PO BOX'"
                 xrcs:message="This address cannot be a post office box or similar address"/>
