                     maxOccurs="unbounded"/>
         <xs:element name="isIncorporatedOverseas" type="YesNo" minOccurs="0"/>
         <xs:element name="businessLicence"
                     type="ForeignBusinessLicence"
                     minOccurs="0"
                     maxOccurs="unbounded"/>
         <xs:element name="taxResidencyCountryCode"
                     type="CountryCode"
                     minOccurs="0"
                     maxOccurs="unbounded"/>
         <xs:element name="businessAddress" type="Address" minOccurs="0"/>
         <xs:element name="postalAddress" type="PostalAddress" minOccurs="0"/>
         <xs:element name="registeredAddress" type="OtherAddress" minOccurs="0"/>
