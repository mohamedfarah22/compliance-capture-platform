   <xs:complexType name="Account">
      <xs:sequence>
         <xs:choice>
            <xs:element name="type" type="AccountType"/>
            <xs:element name="typeOther" type="Description"/>
         </xs:choice>
         <xs:element name="title" type="AcctTitle" minOccurs="0"/>
         <xs:element name="bsb" type="AcctBSB" minOccurs="0"/>
         <xs:element name="number" type="AcctNumber" minOccurs="0"/>
         <xs:element name="proxy" minOccurs="0">
            <xs:simpleType>
               <xs:restriction base="xs:token">
                  <xs:maxLength value="140"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="tokenDetails" type="AccountTokenDetails" minOccurs="0"/>
         <xs:element name="destinationTagMemo" minOccurs="0">
            <xs:simpleType>
               <xs:restriction base="xs:token">
                  <xs:pattern value="[0-9a-zA-Z]{0,140}"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="isAccountProvider" type="YesNo" minOccurs="0"/>
         <xs:element name="provider" minOccurs="0">
            <xs:simpleType>
               <xs:restriction base="xs:token">
                  <xs:maxLength value="140"/>
               </xs:restriction>
            </xs:simpleType>
         </xs:element>
         <xs:element name="cardType"
                     type="CardType"
                     default="CARDUNKNOWN"
                     minOccurs="0"/>
         <xs:element name="isAccountHolder" type="YesNo" minOccurs="0"/>
         <xs:element name="isAccountSignatory" type="YesNo" minOccurs="0"/>
         <xs:element name="openedDate" type="DateNoTimeZone" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="RequiredAttrs"/>
      <!-- title --><xs:assert test="if (type != 'DIGTLWALLET' and type != 'DIGWALL' or exists(typeOther)) then exists(title) else true()"
                 xrcs:message="Account title must be provided for this account type"/>
      <!-- bsb --><xs:assert test="if (type = 'BETTING' or type = 'BULLION' or type = 'CARD' or type = 'DIGTLWALLET' or type = 'INS' or type = 'HIRE'       or type = 'REMIT' or type = 'TRADE' or type = 'DIGWALL') then empty(bsb) else true()"
                 xrcs:message="Bank State Branch (BSB) must not be provided for this account type"/>
      <!-- number --><xs:assert test="if (type = 'BETTING' or type = 'BULLION' or type = 'CUSTODY' or type = 'FCUR' or type = 'INS' or type = 'INVEST'       or type = 'HIRE' or type = 'LOAN' or type = 'PENSION' or type = 'REMIT' or type = 'RETIRE' or type = 'TRADE' or type = 'TRUST' or type = 'SUPER'       or type = 'DIGWALL' or exists(typeOther)) then exists(number) else true()"
                 xrcs:message="Account number must be provided for this account type"/>
      <!-- proxy --><xs:assert test="if (type != 'CHEQUE' or exists(typeOther)) then empty(proxy) else true()"
                 xrcs:message="Proxy must not be provided for this account type"/>
      <!-- tokenDetails --><xs:assert test="if (type != 'CARD' and type != 'DIGTLWALLET' or exists(typeOther)) then empty(tokenDetails) else true()"
                 xrcs:message="Token details must not be provided for this account type"/>
      <!-- destinationTagMemo --><xs:assert test="if (type != 'DIGWALL' or exists(typeOther)) then empty(destinationTagMemo) else true()"
                 xrcs:message="Destination tag or memo must not be provided for this account type"/>
      <!-- isAccountProvider --><xs:assert test="if (type != 'DIGWALL') then exists(isAccountProvider) else true()"
                 xrcs:message="Indicate if your business is the account provider"/>
      <xs:assert test="if (type = 'DIGWALL') then empty(isAccountProvider) and empty(provider) and empty(cardType) and empty(isAccountHolder) and empty(isAccountSignatory) and empty(openedDate) else true()"
                 xrcs:message="Do not provide account details if your business is not the account provider"/>
      <xs:assert test="if (isAccountProvider = 'N') then exists(provider) else true()"
                 xrcs:message="Provide the account provider details if your business is not the account provider"/>
      <xs:assert test="if (isAccountProvider = 'N') then empty(cardType) and empty(isAccountHolder) and empty(isAccountSignatory) and empty(openedDate) else true()"
                 xrcs:message="Do not provide account details if your business is not the account provider"/>
      <xs:assert test="if (isAccountProvider = 'Y') then empty(provider) else true()"
                 xrcs:message="Do not provide account provider details if your business is the account provider"/>
      <xs:assert test="if (isAccountProvider = 'Y' and type != 'BETTING' and type != 'BULLION') then exists(isAccountHolder) else true()"
                 xrcs:message="Indicate if the party is an account holder if your business is the account provider"/>
      <xs:assert test="if (isAccountProvider = 'Y' and type != 'BETTING' and type != 'BULLION') then exists(isAccountSignatory) else true()"
                 xrcs:message="Indicate if the party is an account signatory if your business is the account provider"/>
      <!-- cardType --><xs:assert test="if (type != 'CARD' or exists(typeOther)) then empty(cardType) else true()"
                 xrcs:message="Card type must not be provided for this type of account"/>
      <!-- isAccountHolder --><xs:assert test="if (type = 'BETTING' or type = 'BULLION') then empty(isAccountHolder) else true()"
                 xrcs:message="Indication of account holder is not required"/>
      <!-- isAccountSignatory --><xs:assert test="if (type = 'BETTING' or type = 'BULLION') then empty(isAccountSignatory) else true()"
                 xrcs:message="Indication of account signatory is not required"/>
      <!-- Conditional validation --><xs:assert test="if (type = 'CHEQUE') then (exists(number) or exists(proxy)) else true()"
                 xrcs:message="Account number or proxy must be provided for this account type"/>
      <xs:assert test="if (type = 'CARD' or type = 'DIGTLWALLET') then (exists(number) or exists(tokenDetails)) else true()"
                 xrcs:message="Account number or token details must be provided for this account type"/>
   </xs:complexType>
