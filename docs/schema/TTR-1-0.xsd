            <xs:element name="pdi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="sei" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="svi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="tci"
                        type="CurrencyAmount"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="wti" type="CurrencyAmount" minOccurs="0"/>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="moneyProvided">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="cash" minOccurs="0"/>
            <xs:element ref="otherMoneyProvided" minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (cash) then (every $fc in cash/foreignCash satisfies ($fc/exchangeRate)) else true()"
                    xrcs:message="Provide the exchange rate for foreign amounts"/>
      </xs:complexType>
   </xs:element>
