<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           xmlns="http://austrac.gov.au/schema/reporting/TTR-1-0"
           xmlns:rpt="http://austrac.gov.au/schema/reporting/TTR-1-0"
           xmlns:xrcs="http://xerces.apache.org"
           xmlns:fn="http://www.w3.org/2005/xpath-functions"
           xmlns:xlink="http://www.w3.org/1999/xlink"
           xmlns:d="http://docbook.org/ns/docbook"
           vc:minVersion="1.1"
           targetNamespace="http://austrac.gov.au/schema/reporting/TTR-1-0"
           elementFormDefault="qualified"
           xml:lang="en"
           xpathDefaultNamespace="##targetNamespace"><!-- xpathDefaultNamespace declaration is required for assertions without namespace -->





          <!--
              Reports made using this XML schema are pursuant to the requirements of section 43 of the AML/CTF Act.
              Criminal penalties may apply for providing false or misleading information and civil penalties may apply for failing to supply information.
          -->
<xs:annotation>
      <xs:documentation source="titlePage">
         <d:title>Electronic report file format specification –
        threshold transaction report</d:title>
         <d:author>
            <d:orgname>Australian Transaction Reports and Analysis Centre (AUSTRAC)</d:orgname>
            <d:uri>http://www.austrac.gov.au/</d:uri>
         </d:author>
         <d:revhistory>
            <d:revision>
               <d:revnumber>1.0</d:revnumber>
               <d:date>July 2026</d:date>
            </d:revision>
         </d:revhistory>
         <d:copyright>
            <d:year>2026</d:year>
            <d:holder>Commonwealth of Australia</d:holder>
         </d:copyright>
         <d:keywordset>
            <d:keyword>AUSTRAC</d:keyword>
            <d:keyword>TTR</d:keyword>
            <d:keyword>Threshold transaction report, financial, bullion, gambling services,
          investment/superannuation/insurance and money services businesses</d:keyword>
            <d:keyword>Report file format</d:keyword>
            <d:keyword>User guide</d:keyword>
            <d:keyword>Schema reference</d:keyword>
            <d:keyword>XSD reference</d:keyword>
         </d:keywordset>
      </xs:documentation>
   </xs:annotation>
   <xs:element name="ttrList">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="reAustracAccountNumber" type="AAN"/>
            <xs:element name="submitterAustracAccountNumber" type="AAN"/>
            <xs:element name="fileName" type="TTRFileName"/>
            <xs:element name="reportCount" type="ReportCount"/>
            <xs:element ref="ttr" maxOccurs="unbounded"/>
         </xs:sequence>
         <xs:assert test="reportCount = fn:count(./rpt:ttr)"
                    xrcs:message="The report count must match the number of reports in the file"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="ttr">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="header" minOccurs="0"/>
            <xs:element name="lppDetails" type="LppDetails"/>
            <xs:element ref="customer" maxOccurs="unbounded"/>
            <xs:choice>
               <xs:sequence>
                  <xs:element ref="otherPerson" maxOccurs="unbounded"/>
                  <xs:element ref="representedOrganisation" minOccurs="0" maxOccurs="unbounded"/>
               </xs:sequence>
               <xs:element ref="methodOfConductingTxn"/>
            </xs:choice>
            <xs:element ref="transaction"/>
            <xs:element ref="recipient" maxOccurs="unbounded"/>
            <xs:element name="isOtherDsProviderInvolved" type="YesNo"/>
            <xs:element ref="otherDsProvider" minOccurs="0" maxOccurs="unbounded"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (lppDetails/lppFlag = 'N') then (every $party in customer satisfies ($party/individualDetails or $party/organisationDetails)) else true()"
                    xrcs:message="Details for each customer are expected unless legal professional privilege is claimed"/>
         <xs:assert test="if (lppDetails/lppFlag = 'N') then (every $party in otherPerson satisfies ($party/sameAsCustomer or $party/individualDetails)) else true()"
                    xrcs:message="Details for each other person are expected unless legal professional privilege is claimed"/>
         <xs:assert test="if (lppDetails/lppFlag = 'N') then (every $party in recipient satisfies          ($party/sameAsCustomer or $party/sameAsRepresentedOrganisation or $party/sameAsOtherPerson or $party/isSameAsReportingEntity          or $party/individualDetails or $party/organisationDetails)) else true()"
                    xrcs:message="Details for each recipient are expected unless legal professional privilege is claimed"/>
         <xs:assert test="if (isOtherDsProviderInvolved = 'Y') then exists(otherDsProvider) else true()"
                    xrcs:message="Provide details of other designated service providers involved in the transaction"/>
         <xs:assert test="if (isOtherDsProviderInvolved = 'N') then empty(otherDsProvider) else true()"
                    xrcs:message="Do not provide other designated service providers if not involved in the transaction"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="header">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="interceptFlag" type="YesNo" fixed="Y" minOccurs="0"/>
            <xs:element name="specialReportingActivityId"
                        type="SpecialReportingActivityId"
                        minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="customer">
      <xs:complexType>
         <xs:sequence>
            <xs:choice minOccurs="0">
               <xs:element name="individualDetails" type="IndividualDetails"/>
               <xs:element name="organisationDetails" type="OrganisationDetails"/>
            </xs:choice>
            <xs:element name="isAccountInvolved" type="YesNo" minOccurs="0"/>
            <xs:element name="account"
                        type="Account"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="isOnlineActivityIdentified" type="YesNo" minOccurs="0"/>
            <xs:element name="onlineActivity"
                        type="OnlineActivity"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (isAccountInvolved = 'Y') then exists(account) else true()"
                    xrcs:message="Provide details of the customer’s account or wallet if involved in the transaction"/>
         <xs:assert test="if (isAccountInvolved = 'N') then empty(account) else true()"
                    xrcs:message="Do not provide the customer’s account or wallet details if not involved in the transaction"/>
         <xs:assert test="if (isOnlineActivityIdentified = 'Y') then exists(onlineActivity) else true()"
                    xrcs:message="Provide details of the customer’s identified online activity"/>
         <xs:assert test="if (isOnlineActivityIdentified = 'N') then empty(onlineActivity) else true()"
                    xrcs:message="Do not provide details of customer’s online activity, if not identified"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="representedOrganisation">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="organisationDetails" type="OrganisationDetails"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="otherPerson">
      <xs:complexType>
         <xs:choice minOccurs="0">
            <xs:element name="sameAsCustomer" type="PartyReference"/>
            <xs:sequence>
               <xs:element name="customerEmployee" type="PartyReference"/>
               <xs:element name="individualDetails" type="IndividualDetails"/>
               <xs:element name="isOnlineActivityIdentified" type="YesNo" minOccurs="0"/>
               <xs:element name="onlineActivity"
                           type="OnlineActivity"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="isAuthorisationUsed" type="YesNo"/>
               <xs:element name="agencyAuthorisation"
                           type="AgencyAuthorisation"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:sequence>
               <xs:element name="individualDetails" type="IndividualDetails"/>
               <xs:element name="isOnlineActivityIdentified" type="YesNo" minOccurs="0"/>
               <xs:element name="onlineActivity"
                           type="OnlineActivity"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="isRepresentingOrganisation" type="YesNo"/>
               <xs:element name="representsOrganisation" type="PartyReference" minOccurs="0"/>
               <xs:element name="isAuthorisationUsed" type="YesNo"/>
               <xs:element name="agencyAuthorisation"
                           type="AgencyAuthorisation"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (isOnlineActivityIdentified = 'Y') then exists(onlineActivity) else true()"
                    xrcs:message="Provide details of the person’s identified online activity"/>
         <xs:assert test="if (isOnlineActivityIdentified = 'N') then empty(onlineActivity) else true()"
                    xrcs:message="Do not provide details of the person’s online activity, if not identified"/>
         <xs:assert test="if (isRepresentingOrganisation = 'Y') then exists(representsOrganisation) else true()"
                    xrcs:message="Provide details of the organisation if this person represents an organisation"/>
         <xs:assert test="if (isRepresentingOrganisation = 'N') then empty(representsOrganisation) else true()"
                    xrcs:message="Do not provide organisation details if this person does not represent any organisation"/>
         <xs:assert test="if (isAuthorisationUsed = 'Y') then exists(agencyAuthorisation) else true()"
                    xrcs:message="Provide details of the authorisation used if the person is authorised to act on behalf of the customer"/>
         <xs:assert test="if (isAuthorisationUsed = 'N') then empty(agencyAuthorisation) else true()"
                    xrcs:message="Do not provide authorisation details if there was no authorisation used to act on behalf of the customer"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="methodOfConductingTxn">
      <xs:complexType>
         <xs:choice>
            <xs:element name="method" type="TransactionMethod"/>
            <xs:element name="otherMethod" type="Description"/>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="recipient">
      <xs:complexType>
         <xs:choice minOccurs="0">
            <xs:element name="sameAsCustomer" type="PartyReference"/>
            <xs:sequence>
               <xs:element name="sameAsOtherPerson" type="PartyReference"/>
               <xs:element name="isAccountInvolved" type="YesNo" minOccurs="0"/>
               <xs:element name="account"
                           type="Account"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:sequence>
               <xs:element name="sameAsRepresentedOrganisation" type="PartyReference"/>
               <xs:element name="isAccountInvolved" type="YesNo" minOccurs="0"/>
               <xs:element name="account"
                           type="Account"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:element name="isSameAsReportingEntity" type="YesNo"/>
            <xs:sequence>
               <xs:choice minOccurs="0">
                  <xs:element name="individualDetails" type="IndividualDetails"/>
                  <xs:element name="organisationDetails" type="OrganisationDetails"/>
               </xs:choice>
               <xs:element name="isAccountInvolved" type="YesNo" minOccurs="0"/>
               <xs:element name="account"
                           type="Account"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
         </xs:choice>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (isAccountInvolved = 'Y') then exists(account) else true()"
                    xrcs:message="Provide details of the recipient’s account or wallet if involved in the transaction"/>
         <xs:assert test="if (isAccountInvolved = 'N') then empty(account) else true()"
                    xrcs:message="Do not provide details of the recipient’s account or wallet if not involved in the transaction"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="transaction">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="designatedService" type="DesignatedSvc"/>
            <xs:element name="txnLocation" type="AddressOrLocation"/>
            <xs:element name="txnDate" type="Date"/>
            <xs:element name="txnTime" type="Time" minOccurs="0"/>
            <xs:element name="txnRefNo" type="TRN"/>
            <xs:element name="txnPurpose" type="Description" minOccurs="0"/>
            <xs:element name="physicalCurrencyDirection" type="PhysicalCurrencyDirection"/>
            <xs:element ref="moneyReceived"/>
            <xs:element ref="moneyProvided"/>
            <xs:element name="totalAmount" type="AudAmount"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
      </xs:complexType>
   </xs:element>
   <xs:simpleType name="TTRFileName">
      <xs:restriction base="xs:token">
         <xs:pattern value="[tT][tT][rR]20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[1-2][0-9]|3[0-1])[0-9]{1,8}\.[xX][mM][lL]"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="TransactionMethod">
      <xs:restriction base="xs:token">
         <xs:enumeration value="C"/>
         <xs:enumeration value="A"/>
         <xs:enumeration value="N"/>
      </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="TTRVirtualAsset">
      <xs:complexContent>
         <xs:extension base="VirtualAsset">
            <xs:sequence>
               <xs:element name="assetControllerSameAs"
                           type="PartyReference"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="assetControllerName"
                           type="NameWithId"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="assetHolderSameAs"
                           type="PartyReference"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
               <xs:element name="assetHolderName"
                           type="NameWithId"
                           minOccurs="0"
                           maxOccurs="unbounded"/>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:element name="moneyReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="cash" minOccurs="0"/>
            <xs:element ref="otherMoneyReceived" minOccurs="0"/>
         </xs:sequence>
         <xs:attributeGroup ref="RequiredAttrs"/>
         <xs:assert test="if (cash) then (every $fc in cash/foreignCash satisfies ($fc/exchangeRate)) else true()"
                    xrcs:message="Provide the exchange rate for foreign amounts"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="otherMoneyReceived">
      <xs:complexType>
         <xs:sequence>
            <xs:element name="dci"
                        type="TTRVirtualAsset"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bui" type="Bullion" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="pmi"
                        type="PreciousMetal"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="psi"
                        type="PreciousStone"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="ppi"
                        type="PreciousProduct"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="rdi"
                        type="RealEstate"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="rsi"
                        type="RealEstate"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bci"
                        type="CurrencyAmount"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bdi"
                        type="CurrencyAmount"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="bpi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="cbi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="chi"
                        type="CurrencyAmount"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="cri" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="dfi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="dti" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="egi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="esi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="fai" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="gci" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="iti" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="ldi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="moi"
                        type="CurrencyAmount"
                        minOccurs="0"
                        maxOccurs="unbounded"/>
            <xs:element name="ndi" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="oci" type="CurrencyAmount" minOccurs="0"/>
            <xs:element name="oti"
                        type="CurrencyAmountOther"
                        minOccurs="0"
